{
  "name": "moss",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/jost": "^0.4.2",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/ui": "~58.0.22",
    "@kingstinct/react-native-healthkit": "^16.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.14.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.17",
    "expo-apple-authentication": "~58.0.2",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "playwright": "^1.62.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "galeria": "node --disable-warning=ExperimentalWarning galeria/construir.mjs",
    "galeria:ver": "node galeria/servir.mjs",
    "galeria:capturas": "node herramientas/capturar-galeria.mjs capturas/galeria",
    "catalogo:verificar": "node herramientas/verificar-catalogo.mjs",
    "shaders:verificar": "node herramientas/verificar-shaders.mjs",
    "web:preparar": "setup-skia-web public",
    "web:exportar": "setup-skia-web public && node --disable-warning=ExperimentalWarning herramientas/alimentos-web.mjs && expo export --platform web --output-dir dist/web",
    "web:ver": "node herramientas/servir-web.mjs",
    "app:capturas": "node herramientas/capturar-app.mjs capturas/app",
    "test": "jest",
    "supabase:verificar": "node --disable-warning=ExperimentalWarning herramientas/verificar-supabase.mjs",
    "alimentos": "node --disable-warning=ExperimentalWarning herramientas/alimentos.mjs",
    "alimentos:verificar": "node --disable-warning=ExperimentalWarning herramientas/verificar-alimentos.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/galeria/",
      "/dist/",
      "/capturas/"
    ]
  }
}
