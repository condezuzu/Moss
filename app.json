      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#03050c",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 170
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "es",
              "en"
            ]
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Moss lee de Salud tu fecha de nacimiento, sexo, altura y peso para calcular tus metas; tus pasos, agua, minutos de atención plena y sueño para encender esos hábitos y estimar tu noche si no tienes reloj; y tu frecuencia cardíaca, frecuencia en reposo, variabilidad y respiración de la noche para la sección Sueño. Moss no escribe en Salud.",
          "NSHealthUpdateUsageDescription": "Moss no escribe en Salud: solo lee los datos de arriba.",
          "background": false
        }
      ],
      "expo-apple-authentication",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Moss usa la cámara para escanear el código de barras o la etiqueta nutricional de lo que comes, y para sacar la foto de una comida o la de tu perfil, si quieres. La etiqueta se lee en el teléfono y Moss no sube tus fotos.",
          "microphonePermission": "Moss usa el micrófono solo mientras dices lo que comiste, para anotarlo. Moss no guarda el audio.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Moss usa tus fotos solo cuando eliges una: la de una comida o la de tu perfil. Las fotos quedan en el teléfono y Moss no las sube.",
          "cameraPermission": "Moss usa la cámara para escanear el código de barras o la etiqueta nutricional de lo que comes, y para sacar la foto de una comida o la de tu perfil, si quieres. La etiqueta se lee en el teléfono y Moss no sube tus fotos.",
          "microphonePermission": "Moss usa el micrófono solo mientras dices lo que comiste, para anotarlo. Moss no guarda el audio."
        }
      ],
      "expo-image",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Moss usa el micrófono solo mientras dices lo que comiste, para anotarlo. Moss no guarda el audio.",
          "speechRecognitionPermission": "Moss convierte en texto lo que dices de tu comida para anotarlo, con el reconocimiento de voz de Apple (en el teléfono cuando el idioma lo permite). Moss no guarda el audio.",
          "androidSpeechServicePackages": []
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.uy.moss.app",
          "widgets": [
            {
              "name": "Cielo",
              "displayName": "Moss",
              "description": "Tus hábitos de hoy, en tu cielo.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            },
            {
              "name": "Noche",
              "displayName": "Tu noche",
              "description": "La noche que estimó Moss, para confirmarla con un toque.",
              "ios": {
                "supportedFamilies": [
                  "accessoryRectangular"
                ]
              }
            }
          ]
        }
      ],
      "expo-app-intents",
      "expo-background-task",
      "./plugins/con-alarmkit"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "inlineModules": {
        "watchedDirectories": [
          "app-intents"
        ]
      }
    },
    "extra": {
      "eas": {
        "projectId": "4c90449d-7deb-4215-b357-910c3b3bd628"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/4c90449d-7deb-4215-b357-910c3b3bd628"
    }
  }
