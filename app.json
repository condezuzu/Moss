{
  "expo": {
    "name": "Moss",
    "slug": "moss",
    "owner": "condeag",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moss",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#03050c",
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uy.moss.app",
      "appleTeamId": "XF9N8X9KJG",
      "buildNumber": "2",
      "usesAppleSignIn": true,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "NSMotionUsageDescription": "Si no usas reloj, Moss mira la actividad del teléfono (quieto, caminando o en auto) para estimar a qué hora te dormiste y te despertaste. Esa actividad no sale del teléfono: solo se guarda la hora estimada.",
        "NSAlarmKitUsageDescription": "Moss suena a la hora que eliges en Sueño y anota cuándo paras la alarma, para saber a qué hora te despertaste.",
        "LSApplicationQueriesSchemes": [
          "ascent"
        ],
        "NSPhotoLibraryAddUsageDescription": "Moss guarda en tus fotos solo una imagen que tú eliges guardar."
      },
      "entitlements": {
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)uy.moss.app",
          "$(AppIdentifierPrefix)uy.condeag.compartido"
        ],
        "com.apple.developer.default-data-protection": "NSFileProtectionCompleteUntilFirstUserAuthentication"
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1",
              "1C8F.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "0A2A.1",
              "3B52.1",
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
