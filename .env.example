# Copia este archivo a .env (está en .gitignore) y completa los valores del proyecto de Supabase.
# En EAS, estas variables viven en el entorno "preview", nunca en eas.json.
# La clave es la "publishable" (sb_publishable_…): Supabase retira las claves anon a fines de 2026.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
