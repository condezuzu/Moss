{
  "$schema": "https://json.schemastore.org/eas.json",
  "cli": {
    "version": ">= 13.4.0",
    "appVersionSource": "local"
  },
  "build": {
    "dev": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "environment": "preview",
      "channel": "development"
    },
    "telefono": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "environment": "preview",
      "channel": "preview"
    },
    "simulador": {
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "resourceClass": "m-medium"
      },
      "environment": "preview",
      "channel": "preview"
    },
    "store": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "environment": "production",
      "channel": "production"
    }
  },
  "submit": {
    "store": {
      "ios": {
        "appleTeamId": "XF9N8X9KJG",
        "ascAppId": "6828034537"
      }
    }
  }
}
